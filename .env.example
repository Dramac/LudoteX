# =====================================================================
# Modèle de configuration — copier en .env et renseigner les valeurs.
# Ne JAMAIS committer le fichier .env (il est ignoré par git).
# =====================================================================

# --- Jeton d'écriture bénévole ---------------------------------------
# Jeton aléatoire long (~32 caractères) autorisant les opérations de
# prêt/retour. Distribué une fois par an aux bénévoles, mémorisé côté
# appareil. À régénérer à chaque édition (rotation annuelle).
# Générer une valeur :  python -c "import secrets; print(secrets.token_urlsafe(32))"
PRET_TOKEN=remplacer_par_un_jeton_aleatoire_long

# --- Mot de passe administrateur -------------------------------------
# Sert UNIQUEMENT à l'amorçage du premier mot de passe de l'espace /admin.
# Au premier démarrage, cette valeur est hachée puis stockée en base ; ensuite,
# le mot de passe se change directement depuis l'écran d'administration.
ADMIN_PASSWORD=remplacer_au_premier_demarrage

# --- Base de données -------------------------------------------------
# Chemin du fichier SQLite. Reste hors du dépôt (dossier data/ ignoré).
DATABASE_PATH=data/pret-jeux.db

# Base SÉPARÉE du module tournois (indépendante de la base de prêt).
TOURNOI_DATABASE_PATH=data/tournoi.db

# Base SÉPARÉE du module planning bénévole (indépendante des deux autres).
PLANNING_DATABASE_PATH=data/planning.db

# --- Domaine / URL publique ------------------------------------------
# Utilisé pour construire les URL encodées dans les QR : <BASE_URL>/jeu/<id_exemplaire>
# Ex. https://pret.mon-asso.fr
BASE_URL=https://pret.example.fr

# --- Nom de l'association ---------------------------------------------
# Affiché dans le bandeau, le pied de page, la page « À propos », les exports
# et les fichiers .ics des tournois. Repli sur "LudoteX" si
# absent (voir app/config.py).
NOM_ASSOCIATION=LudoteX

# --- Limitation de débit (écriture) ----------------------------------
# Nombre maximal de tentatives d'écriture par minute et par IP.
RATE_LIMIT_PER_MINUTE=60

# --- Environnement ---------------------------------------------------
# development | production
APP_ENV=development

# --- Mode formation ----------------------------------------------------
# Bascule cette instance en SITE DE FORMATION (bandeau + filigrane sur toutes
# les pages, bouton de réinitialisation des données en admin). Voir
# docs/mode-formation.md. NE JAMAIS activer sur l'instance de production —
# à réserver à une SECONDE INSTANCE dédiée, avec ses propres bases jetables
# (DATABASE_PATH / TOURNOI_DATABASE_PATH / PLANNING_DATABASE_PATH ci-dessus
# pointant alors vers des chemins séparés de la production).
# 1 | true | on -> actif ; absent/autre valeur -> inactif (défaut).
MODE_FORMATION=0

# URL de l'instance de formation, affichée en lien depuis le tableau de bord
# de l'instance de PRODUCTION (masqué si absent). Sans effet si MODE_FORMATION
# est actif sur cette instance.
# FORMATION_URL=https://formation.mon-asso.fr

# CSV du catalogue à recopier dans la base de formation, à la place des jeux
# fictifs (lu à chaque réinitialisation des données de formation, jamais écrit).
# À quoi ça sert : les QR imprimés encodent l'identifiant de la boîte. Avec un
# catalogue fictif, une vraie boîte scannée pendant une formation affiche
# « boîte inconnue » ; avec ce fichier, le site de formation connaît les mêmes
# boîtes que la production et les étiquettes déjà collées fonctionnent.
# Le fichier attendu est l'export du catalogue produit par « Données &
# sauvegarde » de la PRODUCTION, déposé à la main : les deux instances
# n'échangent rien à l'exécution. Chemin introuvable ou fichier illisible :
# repli sur les jeux fictifs, avec un avertissement dans les journaux.
# Sans objet hors instance de formation.
# FORMATION_CATALOGUE_CSV=/var/lib/ludotex-formation/catalogue.csv

# --- Journal d'activité -------------------------------------------------
# Fichier JSON Lines du journal d'activité (voir docs/conception-journal.md).
# Sur une instance de formation : chemin DISTINCT de la production, sinon les
# deux instances écrivent dans le même fichier.
JOURNAL_PATH=data/journal.log

# Recopie chaque ligne (formatée pour l'œil) sur la console du process — utile
# en phase de test. 1 | true | on -> actif ; absent/autre valeur -> inactif
# (défaut), pour qu'une production n'hérite pas de ce comportement par erreur.
JOURNAL_CONSOLE=0
